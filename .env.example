# ---------------------------------------------------------------------------
# Paddle — client side (safe to expose; these ship in the browser bundle)
# ---------------------------------------------------------------------------

# 'sandbox' or 'production'. Never defaulted: if this is unset the app throws
# rather than risk running against the wrong Paddle account.
NEXT_PUBLIC_PADDLE_ENV=production

# Paddle > Developer tools > Authentication > Client-side tokens.
# Must start with live_ when NEXT_PUBLIC_PADDLE_ENV=production, test_ on sandbox.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_replace_me

# ---------------------------------------------------------------------------
# Paddle — server side (SECRET; never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Paddle > Developer tools > Notifications > your destination > Secret key.
# Used to verify that incoming webhooks genuinely came from Paddle.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me

# Paddle > Developer tools > Authentication > API keys.
# transaction.completed only carries customer_id, so the webhook needs this to
# look up the buyer's email address before it can send them their template.
PADDLE_API_KEY=pdl_live_apikey_replace_me

# ---------------------------------------------------------------------------
# Delivery email (Resend — https://resend.com)
# ---------------------------------------------------------------------------

RESEND_API_KEY=re_replace_me

# Must be a domain you have verified in Resend.
DELIVERY_FROM_EMAIL="Devora Kit <contact@devorakit.com>"

# Optional: copy of every delivery email, useful while you are still watching orders.
DELIVERY_BCC_EMAIL=
